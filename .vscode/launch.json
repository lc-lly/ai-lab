{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: FastAPI",
      "preLaunchTask": "kill-port-8000",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "app.main:app"
      ],
      "jinja": true,
      "justMyCode": false,
      "subProcess": true
    }
  ]
}