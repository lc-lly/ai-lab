# 复制本文件为 .env 后按实际情况填写（.env 已被 .gitignore 忽略，不要提交真实密钥）
#   cp .env.example .env

# ---------- 数据库 ----------
# 需要先手动创建数据库：CREATE DATABASE `ai-lab` DEFAULT CHARACTER SET utf8mb4;
# 数据表由后端启动时自动创建（Base.metadata.create_all）
# 密码含 @ : / 等特殊字符时需做 URL 编码
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/ai-lab

# ---------- JWT ----------
# 生产环境请替换为一串足够随机的字符串，泄露后任何人都能伪造登录态
JWT_SECRET_KEY=请替换为一串足够随机的字符串
# token 有效期（小时）
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# ---------- 大模型 ----------
# 走 OpenAI 兼容协议，可对接 DeepSeek / 通义千问 / OpenAI 等
# 以下为 DeepSeek 示例，换成其它服务商时三个值需要一起改
LLM_API_KEY=sk-你的APIKey
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
